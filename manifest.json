{
  "manifest_version": 3,
  "name": "Lofter Customizer",
  "description": "自定义 Lofter 背景、卡片材质、字体与导航栏样式，支持关键词/用户过滤、评论区隐藏与增强、实时字数统计",
  "version": "1.3.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.lofter.com/*",
    "https://lofter.com/*",
    "https://*.lf127.net/*",
    "https://lf127.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": [
        "https://*.lofter.com/*",
        "https://lofter.com/*",
        "https://lofter.lf127.net/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-decorations": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "显示/隐藏装饰图"
    },
    "toggle-edit-mode": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "进入/退出编辑位置模式"
    },
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "切换深色模式"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
  {
    "matches": [
      "https://*.lofter.com/*",
      "https://lofter.com/*",
      "https://lofter.lf127.net/lofter-admin/*"
    ],
    "js": ["defaults.js", "hyalite.js", "lc-dwr.js", "content.js", "wc-frame.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  },
  {
    "matches": [
      "https://*.lf127.net/*",
      "https://lf127.net/*"
    ],
    "js": ["wc-frame.js"],
    "run_at": "document_idle",
    "all_frames": true
  }
]
}
